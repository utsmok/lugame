{
  "name": "lugame",
  "version": "0.1.0",
  "description": "A grid programming game for young kids — guide a peacock to a cookie by queuing commands. Inspired by Lightbot, GCompris, Karel the Robot.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
